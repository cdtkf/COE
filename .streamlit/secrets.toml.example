# Streamlit secrets template — copy to `.streamlit/secrets.toml` for local
# development (and add to .gitignore), or paste the same key=value pairs
# into Streamlit Cloud → app settings → Secrets.
#
# Streamlit looks for this file at .streamlit/secrets.toml in the repo root.
# Anything here is accessible at runtime as `st.secrets["KEY"]`.

# Postgres connection string for the dashboard. Use the connection string
# from Neon (or whatever Postgres you're pointing at) verbatim — including
# the `?sslmode=require` suffix Neon shows in the console.
#
# Example (do NOT commit your real one):
#   DATABASE_URL = "postgresql+psycopg2://neondb_owner:XXXXXXXX@ep-xxxx-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL = "postgresql+psycopg2://USER:PASSWORD@HOST/DB?sslmode=require"
